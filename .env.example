# Canonical origin for metadata, sitemap, and Open Graph.
# Confirm the production domain before launch. Do not leave localhost in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public contact details. Defaults are published on the site if these are blank.
NEXT_PUBLIC_CONTACT_EMAIL=contact@theinterieri.com
NEXT_PUBLIC_CONTACT_PHONE=+91 84314 16032
NEXT_PUBLIC_CONTACT_ADDRESS=

# Form delivery — at least one path is required for successful submissions.
# Option A: webhook (CRM, Make, Zapier, n8n, or a future API).
FORM_WEBHOOK_URL=
FORM_WEBHOOK_TOKEN=

# Option B: Resend email. Requires a verified from-address.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
ENQUIRY_TO_EMAIL=

# Optional product analytics write key. Unused until a vendor is wired.
NEXT_PUBLIC_ANALYTICS_WRITE_KEY=

# Optional future app origins (do not build those apps in this repository).
NEXT_PUBLIC_FIRM_APP_URL=
NEXT_PUBLIC_CUSTOMER_APP_URL=
